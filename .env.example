# Claude API — obrigatoria. Somente servidor, nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# ADR-005 / OQ-1: ponto unico de troca de tier.
# claude-opus-5 (~US$0,13/analise) | claude-sonnet-5 (~US$0,05) | claude-haiku-4-5 (~US$0,026)
ANTHROPIC_MODEL=claude-opus-5

# Caps de conteudo — defesa 2 de protecao-custo
MAX_CONTENT_BYTES=2000000
MAX_ANALYZABLE_SENTENCES=400
MAX_SENTENCES_PER_LLM_CALL=80

# Budget guard — defesa 3
DAILY_TOKEN_BUDGET=2000000
MAX_TOKENS_PER_REQUEST=40000

# Rate limit — defesa 1
RATE_LIMIT_PER_HOUR=10

FETCH_TIMEOUT_MS=10000
MAX_REDIRECTS=3

# ADR-004
METHODOLOGY_URL=/metodologia

# M4 — contadores fora do processo (OQ-2). Vazio em dev.
REDIS_URL=
REDIS_TOKEN=
