# ATENCAO: este arquivo e VERSIONADO. Nunca preencha valores reais aqui.
# Copie para .env.local (ignorado pelo git) e preencha la.

# Qual provedor classifica: gemini | anthropic
# `gemini` e o default porque tem cota gratuita real, e o produto precisa
# poder ficar publico sem custo por analise. A troca e barata porque
# ClaimClassifier e uma PORTA (ADR-001).
LLM_PROVIDER=gemini

# A chave EXIGIDA e a do provedor escolhido acima — nao as duas.
# Somente servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Qual modelo esta na cota gratuita, e com que limites, MUDA com o tempo.
# Confira os limites atuais antes de contar com eles.
GEMINI_MODEL=gemini-2.0-flash

# ADR-005 / OQ-1: ponto unico de troca de tier.
# Custo real MEDIDO com claude-haiku-4-5: US$0,0155 por artigo.
ANTHROPIC_MODEL=claude-haiku-4-5

# Caps de conteudo — defesa 2 de protecao-custo
MAX_CONTENT_BYTES=2000000
MAX_ANALYZABLE_SENTENCES=400
MAX_SENTENCES_PER_LLM_CALL=80

# Budget guard — defesa 3. Denominado em DOLARES, nao em tokens: a saida
# custa 5x a entrada e responde por ~73% do custo real, entao um teto sobre
# tokens de entrada limitaria so a parte barata do gasto.
# Com US$1,00/dia e custo tipico de US$0,0155, cabem ~64 analises por dia.
DAILY_BUDGET_USD=1.00
MAX_REQUEST_BUDGET_USD=0.10

# Precos do modelo, por milhao de tokens.
#
# No free tier do Gemini o custo real e ZERO, mas manter precos aqui NAO e
# inutil: o teto diario em dolares passa a funcionar como teto de VOLUME,
# limitando quantas analises acontecem por dia. Zerar estes valores desligaria
# a guarda inteira, e o unico limite passaria a ser a cota do provedor — que
# ao estourar produz erro para o visitante em vez de recusa controlada.
MODEL_INPUT_USD_PER_MTOK=1.00
MODEL_OUTPUT_USD_PER_MTOK=5.00

# Saida estimada como fracao da entrada, para o pre-flight.
# Medido: 0,53. O default tem margem porque subestimar fura o teto.
BUDGET_OUTPUT_RATIO=0.70

# Rate limit — defesa 1
RATE_LIMIT_PER_HOUR=10

FETCH_TIMEOUT_MS=10000
MAX_REDIRECTS=3

# ADR-004. Aponta para a secao "O que nao medimos" da propria pagina, que
# EXISTE. O valor anterior era /metodologia, uma rota nunca criada — o link
# "Ler o metodo" no painel de resultado dava 404. Pagina dedicada e' debito
# registrado em specs/changes/001-.../tasks.md.
METHODOLOGY_URL=/#metodo

# Contadores fora do processo (OQ-2 — Upstash Redis).
# A PRESENCA destas duas variaveis seleciona os adapters de producao.
# Vazias em dev: o container monta os adapters locais, que lancam se
# NODE_ENV=production. Deploy sem elas falha alto, de proposito.
REDIS_URL=
REDIS_TOKEN=
